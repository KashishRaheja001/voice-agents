# Copy to .env and fill in. Never commit .env.
# Provider keys used by Dograh live in Dograh's Providers page; these are only for
# local scripts and the Dograh MCP server.

# Dograh API key (app.dograh.com/api-keys), used by .mcp.json and scripts
DOGRAH_API_KEY=

# Only needed if local scripts call these directly
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# Telephony (later)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
