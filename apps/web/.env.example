# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key: server only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Dograh (app.dograh.com/api-keys). One key for our account; each customer has its own
# agent trigger ID, stored per workspace in Settings.
DOGRAH_API_KEY=
# Optional: set for self-hosted Dograh, e.g. https://dograh.example.com/api/v1
DOGRAH_API_URL=
# Shared secret Dograh sends in the X-Webhook-Secret header on webhooks and tool calls.
# Generate with: openssl rand -hex 32
DOGRAH_WEBHOOK_SECRET=

# Calling hours guard (IST). Defaults: 9 to 21. Set ENFORCED=false only for testing.
# CALLING_HOURS_ENFORCED=true
# CALLING_HOURS_START=9
# CALLING_HOURS_END=21

# Cost controls and pricing display (all optional; values are placeholders, unverified)
# PRICE_PER_MIN=3            # what the customer pays per minute (billed per 30 s)
# COST_PER_MIN=2.8           # our all-in cost per minute
# MAX_ATTEMPTS_PER_LEAD=3    # stop re-calling a lead after N calls (0 = no limit)
# MONTHLY_MINUTES_LIMIT=0    # default monthly billable-minute cap per customer (0 = none)
